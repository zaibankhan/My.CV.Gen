// Prisma schema for My.CV.Gen
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum AuthProvider {
  email
  google
  github
}

enum CVStatus {
  draft
  in_progress
  completed
}

enum AIProvider {
  openai
  anthropic
  groq
}

enum SSOProvider {
  google
  github
}

// ==================== MODELS ====================

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  provider     AuthProvider @default(email)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cvDocuments   CvDocument[]
  accounts      Account[]
  sessions      Session[]
  aiLogs        AiGenerationLog[]
  rateLimits    RateLimit[]
  subscriptions Subscription[]

  @@map("users")
}

model Account {
  id                 String       @id @default(cuid())
  userId             String
  type               String
  provider           SSOProvider
  providerAccountId  String
  refresh_token      String?      @db.Text
  access_token       String?      @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?      @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Main CV document model
model CvDocument {
  id           String    @id @default(cuid())
  userId       String
  title        String    @default("Untitled CV")
  templateId   String    @default("modern")
  designConfig Json      @default("{}")   // colors, fonts, layout config
  content      Json      @default("{}")   // all CV data (personal, experience, education, skills)
  aiProvider   AIProvider @default(openai)
  status       CVStatus  @default(draft)
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions CvVersion[]
  aiLogs   AiGenerationLog[]

  @@index([userId, status])
  @@map("cv_documents")
}

/// Snapshot of past CV versions
model CvVersion {
  id            String   @id @default(cuid())
  cvDocumentId  String
  contentSnapshot Json
  designSnapshot  Json
  createdAt     DateTime @default(now())
  label         String?  // e.g., "Before editing summary"

  cvDocument CvDocument @relation(fields: [cvDocumentId], references: [id], onDelete: Cascade)

  @@index([cvDocumentId])
  @@map("cv_versions")
}

/// Log of AI generation calls for analytics and cost tracking
model AiGenerationLog {
  id               String    @id @default(cuid())
  userId           String
  cvDocumentId     String?
  provider         AIProvider
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  responseTimeMs   Int
  success          Boolean   @default(true)
  errorMessage     String?
  createdAt        DateTime  @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvDocument   CvDocument? @relation(fields: [cvDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_generation_logs")
}

/// Usage rate limits per user
model RateLimit {
  id             String   @id @default(cuid())
  userId         String
  aiCallsUsed    Int      @default(0)
  aiCallsLimit   Int      @default(20)
  periodStart    DateTime @default(now())
  periodEnd      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@map("rate_limits")
}

/// Subscription / plan details
model Subscription {
  id           String    @id @default(cuid())
  userId       String?   @unique
  plan         String    @default("free")  // free, pro, enterprise
  stripeId     String?   @unique
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("subscriptions")
}
